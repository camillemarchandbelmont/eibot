# --- Discord ---------------------------------------------------------------
DISCORD_TOKEN=
# IDs de tes serveurs, séparés par des virgules : les commandes y apparaissent
# immédiatement au lieu d'attendre la propagation globale. `GUILD_ID` (singulier)
# reste accepté en repli, pour ne pas casser une configuration existante.
GUILD_IDS=

# --- API Empire Immo -------------------------------------------------------
# Renseigne la clé et le bot lit l'export en ligne au lieu du CSV local.
EMPIRE_API_KEY=
# Optionnel : pour un autre monde que M8, ou si l'URL change.
# EMPIRE_API_URL=https://monde8.empireimmo.com/api/buildings_batiments_entreprise.csv?key={api_key}

# --- Base de données -------------------------------------------------------
# Vide = configuration en mémoire, perdue au redémarrage.
DATABASE_URL=

# --- Serveur HTTP ----------------------------------------------------------
PORT=10000
# Jeton partagé avec cron-job.org pour protéger /tick.
TICK_TOKEN=
# Secret partagé avec le site web (projet Vercel), pour les routes /api/*.
# Vide = toutes ces routes répondent 401, y compris les lectures.
# Volontairement distinct de TICK_TOKEN : celui-ci circule dans une query
# string, donc dans les journaux d'accès. Générer avec : openssl rand -base64 32
API_SECRET=

# --- Réglages par défaut (surchargeables par /config) ----------------------
PRIX_MIN=1e14
PRIX_MAX=6e15
HEURE=09:00
FUSEAU=Europe/Paris
# Premier salon de publication. Les suivants s'ajoutent par
# /config salon ajouter.
SALON_ID=
ROLE_ID=
# Salon où le bot rapporte ses publications et ses pannes. Vide = désactivé.
LOGS_SALON_ID=
